<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_import" targetNamespace="https://crm.dihag.de/bpmn" exporter="DIHAG BPMN-Generator (scripts/bpmn/generate-bpmn.js)" exporterVersion="2.0">
  <bpmn:collaboration id="Collab_import">
    <bpmn:participant id="P_Imp" name="DIHAG · Datensätze ins CRM schreiben" processRef="Process_CRM_Timeline_Import" />
    <bpmn:participant id="P_Dyn" name="Dynamics 365 (Dataverse)" />
    <bpmn:messageFlow id="Msg_I_40_P_Dyn" name="Stapel über die Web-API" sourceRef="I_40" targetRef="P_Dyn" />
  </bpmn:collaboration>
  <bpmn:process id="Process_CRM_Timeline_Import" name="Datensätze ins CRM schreiben" isExecutable="false">
    <bpmn:documentation>Die sechs Schritte des Importprofils, in dieser Reihenfolge und in einem Lauf. Geschrieben wird in Stapeln; scheitert eine Zeile, laufen die übrigen weiter, und die gescheiterte steht mit Grund im Protokoll. Eine im CRM geschlossene Verkaufschance ist schreibgeschützt – verloren gegebene werden wieder geöffnet, gewonnene bleiben unberührt.
Eingebunden in: Anfragen aus TimeLine ins CRM übernehmen.
Anwender-Ansicht: https://crm.dihag.de/prozess.html#uebernahme
Im Einklang mit den Richtlinien: ISMS-Richtlinie Sichere Softwareentwicklung; ISMS-Richtlinie Aufbewahrungsfristen und -pflichten
[[rms:policies=111,119]]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P_Imp">
      <bpmn:lane id="LA" name="CRM-Schnittstelle (Automatik)"><bpmn:flowNodeRef>I_start</bpmn:flowNodeRef><bpmn:flowNodeRef>I_10</bpmn:flowNodeRef><bpmn:flowNodeRef>I_20</bpmn:flowNodeRef><bpmn:flowNodeRef>I_gw1</bpmn:flowNodeRef><bpmn:flowNodeRef>I_30</bpmn:flowNodeRef><bpmn:flowNodeRef>I_40</bpmn:flowNodeRef><bpmn:flowNodeRef>I_50</bpmn:flowNodeRef><bpmn:flowNodeRef>I_gw3</bpmn:flowNodeRef><bpmn:flowNodeRef>I_60</bpmn:flowNodeRef><bpmn:flowNodeRef>I_end</bpmn:flowNodeRef><bpmn:flowNodeRef>I_gw2</bpmn:flowNodeRef><bpmn:flowNodeRef>I_open</bpmn:flowNodeRef><bpmn:flowNodeRef>I_skip</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
      <bpmn:startEvent id="I_start" name="Mappe ist geprüft und ohne offene Frage"><bpmn:outgoing>Flow_I_start_I_10</bpmn:outgoing></bpmn:startEvent>
      <bpmn:serviceTask id="I_10" name="10 Firmen über die Kundennummer zuordnen"><bpmn:incoming>Flow_I_start_I_10</bpmn:incoming><bpmn:outgoing>Flow_I_10_I_20</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="I_20" name="20 Kontakte anlegen oder aktualisieren"><bpmn:incoming>Flow_I_10_I_20</bpmn:incoming><bpmn:outgoing>Flow_I_20_I_gw1</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:exclusiveGateway id="I_gw1" name="Verkaufschance im CRM geschlossen?"><bpmn:incoming>Flow_I_20_I_gw1</bpmn:incoming><bpmn:outgoing>Flow_I_gw1_I_30</bpmn:outgoing><bpmn:outgoing>Flow_I_gw1_I_gw2</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:serviceTask id="I_30" name="30 Verkaufschance anlegen oder aktualisieren"><bpmn:incoming>Flow_I_gw1_I_30</bpmn:incoming><bpmn:outgoing>Flow_I_30_I_40</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="I_40" name="40 Positionen je Verkaufschance ersetzen"><bpmn:incoming>Flow_I_open_I_40</bpmn:incoming><bpmn:incoming>Flow_I_30_I_40</bpmn:incoming><bpmn:outgoing>Flow_I_40_I_50</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="I_50" name="50 Vertriebsprozess auf die Stufe aus der Datei setzen"><bpmn:incoming>Flow_I_40_I_50</bpmn:incoming><bpmn:outgoing>Flow_I_50_I_gw3</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:exclusiveGateway id="I_gw3" name="In der Datei abgeschlossen?"><bpmn:incoming>Flow_I_50_I_gw3</bpmn:incoming><bpmn:outgoing>Flow_I_gw3_I_60</bpmn:outgoing><bpmn:outgoing>Flow_I_gw3_I_end</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:serviceTask id="I_60" name="60 Verkaufschance mit ihrem Ergebnis schliessen"><bpmn:incoming>Flow_I_gw3_I_60</bpmn:incoming><bpmn:outgoing>Flow_I_60_I_end</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:endEvent id="I_end" name="Datensätze stehen im CRM"><bpmn:incoming>Flow_I_gw3_I_end</bpmn:incoming><bpmn:incoming>Flow_I_60_I_end</bpmn:incoming></bpmn:endEvent>
      <bpmn:exclusiveGateway id="I_gw2" name="War sie verloren?"><bpmn:incoming>Flow_I_gw1_I_gw2</bpmn:incoming><bpmn:outgoing>Flow_I_gw2_I_open</bpmn:outgoing><bpmn:outgoing>Flow_I_gw2_I_skip</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:serviceTask id="I_open" name="Verkaufschance wieder öffnen und den alten Grund als Notiz sichern"><bpmn:incoming>Flow_I_gw2_I_open</bpmn:incoming><bpmn:outgoing>Flow_I_open_I_40</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:endEvent id="I_skip" name="übersprungen – gewonnene Verkaufschance bleibt unberührt"><bpmn:incoming>Flow_I_gw2_I_skip</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_I_start_I_10" sourceRef="I_start" targetRef="I_10" />
      <bpmn:sequenceFlow id="Flow_I_10_I_20" sourceRef="I_10" targetRef="I_20" />
      <bpmn:sequenceFlow id="Flow_I_20_I_gw1" sourceRef="I_20" targetRef="I_gw1" />
      <bpmn:sequenceFlow id="Flow_I_gw1_I_30" sourceRef="I_gw1" targetRef="I_30" name="nein" />
      <bpmn:sequenceFlow id="Flow_I_gw1_I_gw2" sourceRef="I_gw1" targetRef="I_gw2" name="ja" />
      <bpmn:sequenceFlow id="Flow_I_gw2_I_open" sourceRef="I_gw2" targetRef="I_open" name="ja" />
      <bpmn:sequenceFlow id="Flow_I_gw2_I_skip" sourceRef="I_gw2" targetRef="I_skip" name="nein" />
      <bpmn:sequenceFlow id="Flow_I_open_I_40" sourceRef="I_open" targetRef="I_40" />
      <bpmn:sequenceFlow id="Flow_I_30_I_40" sourceRef="I_30" targetRef="I_40" />
      <bpmn:sequenceFlow id="Flow_I_40_I_50" sourceRef="I_40" targetRef="I_50" />
      <bpmn:sequenceFlow id="Flow_I_50_I_gw3" sourceRef="I_50" targetRef="I_gw3" />
      <bpmn:sequenceFlow id="Flow_I_gw3_I_60" sourceRef="I_gw3" targetRef="I_60" name="ja" />
      <bpmn:sequenceFlow id="Flow_I_gw3_I_end" sourceRef="I_gw3" targetRef="I_end" name="nein" />
      <bpmn:sequenceFlow id="Flow_I_60_I_end" sourceRef="I_60" targetRef="I_end" />
      <bpmn:textAnnotation id="An_dubl"><bpmn:text>Mehrfachtreffer: gibt es genau einen aktiven Datensatz, gewinnt dieser ohne Rückfrage. Sonst hält der Lauf an.</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="Assoc_An_dubl" associationDirection="None" sourceRef="I_20" targetRef="An_dubl" />
  </bpmn:process>
